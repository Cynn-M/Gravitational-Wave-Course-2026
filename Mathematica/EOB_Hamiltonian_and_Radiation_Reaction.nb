Cell["Radiation Forces RR", "Text",
 CellChangeTimes->{{4.0031892795714226`*^9, 
  4.003189315147213*^9}},ExpressionUUID->"8dd2ba88-d3d9-424e-99f3-\
2e69db6a5c68"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Radial", " ", "radiation"}], "-", 
    RowBox[{"reaction", " ", "force"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"FrOrbitD", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"8", " ", 
          RowBox[{"nuC", "/", 
           RowBox[{"(", 
            RowBox[{"15", " ", 
             RowBox[{"rOrbitD", "^", "3"}]}], ")"}]}]}], ")"}], " ", 
        "pROrbitD", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "3"}], " ", "alphaC"}], "+", 
             RowBox[{"9", " ", "betaC"}], "+", "3"}], ")"}], " ", 
           "p2OrbitD"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"9", " ", "alphaC"}], "-", 
             RowBox[{"15", " ", "betaC"}], "+", "9"}], ")"}], " ", 
           RowBox[{"pROrbitD", "^", "2"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"9", " ", "alphaC"}], "-", 
             RowBox[{"9", " ", "betaC"}], "+", "17"}], ")"}], "/", 
           "rOrbitD"}]}], ")"}]}], ",", 
       RowBox[{"Assumptions", "->", "assumptionsD"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Azimuthal", " ", "radiation"}], "-", 
     RowBox[{"reaction", " ", "force"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FphiOrbitD", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"8", " ", 
          RowBox[{"nuC", "/", 
           RowBox[{"(", 
            RowBox[{"15", " ", 
             RowBox[{"rOrbitD", "^", "3"}]}], ")"}]}]}], ")"}], " ", 
        "pPhiOrbitD", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"9", " ", 
           RowBox[{"(", 
            RowBox[{"alphaC", "+", "1"}], ")"}], " ", 
           RowBox[{"pROrbitD", "^", "2"}]}], "-", 
          RowBox[{"3", " ", 
           RowBox[{"(", 
            RowBox[{"2", "+", "alphaC"}], ")"}], " ", "p2OrbitD"}], "+", 
          RowBox[{"3", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"alphaC", "-", "2"}], ")"}], "/", "rOrbitD"}]}]}], 
         ")"}]}], ",", 
       RowBox[{"Assumptions", "->", "assumptionsD"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TraditionalForm", "/@", 
     RowBox[{"{", 
      RowBox[{"FrOrbitD", ",", "FphiOrbitD"}], "}"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.003189296938484*^9, 4.0031892969453373`*^9}, 
   4.003189422034357*^9},
 CellLabel->
  "In[178]:=",ExpressionUUID->"604e9805-bd7d-2542-98da-84d9c69369d3"],

