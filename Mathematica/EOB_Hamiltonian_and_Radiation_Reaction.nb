Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ExpectedPhiEccR", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"32", "/", "5"}], ")"}], " ", 
     RowBox[{"G", "^", "4"}], " ", 
     RowBox[{"mu", "^", "2"}], " ", 
     RowBox[{
      RowBox[{"M", "^", "3"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c", "^", "5"}], " ", 
        RowBox[{"R", "^", "5"}]}], ")"}]}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"e", "^", "2"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"3", "/", "2"}], ")"}]}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"73", "/", "24"}], ")"}], 
        RowBox[{"e", "^", "2"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"37", "/", "96"}], ")"}], 
        RowBox[{"e", "^", "4"}]}]}], ")"}]}]}], ";"}], " ", 
