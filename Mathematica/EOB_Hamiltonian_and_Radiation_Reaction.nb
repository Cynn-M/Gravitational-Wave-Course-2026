Cell[CellGroupData[{

Cell["Orbital averages and analytical verification", "Subtitle",
 CellChangeTimes->{
  4.003182189699316*^9},ExpressionUUID->"938f954f-07e3-804c-8739-\
6b7413ed5d94"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"aOrbit", "=", 
    RowBox[{"R", "/", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"e", "^", "2"}]}], ")"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Semi", "-", 
    RowBox[{"major", " ", "axis"}]}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Torb", "=", 
    RowBox[{"2", " ", "Pi", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"aOrbit", "^", "3"}], "/", 
       RowBox[{"(", 
        RowBox[{"G", " ", "M"}], ")"}]}], "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Orbital", " ", "period"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Physical", " ", "assumptions"}], "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"assumptions", "=", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"G", ",", "M", ",", "mu", ",", "R", ",", "e", ",", "c"}], 
        "}"}], ",", "Reals"}], "]"}], "&&", 
     RowBox[{"G", ">", "0"}], "&&", 
     RowBox[{"M", ">", "0"}], "&&", 
     RowBox[{"mu", ">", "0"}], "&&", 
     RowBox[{"R", ">", "0"}], "&&", 
     RowBox[{"c", ">", "0"}], "&&", 
     RowBox[{"0", "<=", "e", "<", "1"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "OrbitalAverage", "]"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Orbital", " ", "average", " ", 
    RowBox[{"operator", ":", " ", 
     RowBox[{
     "This", " ", "function", " ", "is", " ", "going", " ", "to", " ", 
      "compute", " ", "the", " ", "average"}]}]}], "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"OrbitalAverage", "[", "expr_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", "Torb"}], ")"}], " ", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"expr", "*", 
       RowBox[{
        RowBox[{"rOrbit", "^", "2"}], "/", "hKepler"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"psi", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
      RowBox[{"Assumptions", "->", "assumptions"}]}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.0031822240592136`*^9, 4.0031822436796036`*^9}, {
  4.003182286924387*^9, 4.0031822906591225`*^9}},
 CellLabel->
  "In[107]:=",ExpressionUUID->"c38e5059-8de5-ca44-8797-87310b0604dc"],

