5c1dd61591f9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Initialize", " ", "notebook"}], "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"massRules", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"M", "->", 
       RowBox[{"m1", "+", "m2"}]}], ",", 
      RowBox[{"mu", "->", 
       RowBox[{"m1", " ", 
        RowBox[{"m2", "/", 
         RowBox[{"(", 
          RowBox[{"m1", "+", "m2"}], ")"}]}]}]}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Physical", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "M", " ", "and", " ", "mu", " ", "are", " ", "kept", " ", "symbolic"}], 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xvec", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"r", "[", "t", "]"}], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"phi", "[", "t", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"r", "[", "t", "]"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"phi", "[", "t", "]"}], "]"}]}], ",", "0"}], "}"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Relative", " ", "position", " ", "vector"}], 
   "*)"}]}], "\n"}], "Input",
 CellChangeTimes->{{4.0031812936784496`*^9, 4.003181334958599*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"70892f99-7b53-5846-90f7-39028513bef6"],

Cell[CellGroupData[{

Cell[TextData[{
 "Quadrupole Momentum Tensor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Q", "ij"], "=", 
    RowBox[{"\[Mu]", "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["x", "i"], 
       SubscriptBox["x", "j"]}], "-", 
      RowBox[{
       FractionBox["1", "3"], 
       SubscriptBox["\[Delta]", "ij"], 
       SuperscriptBox["r", "2"]}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"1e582d7d-bb11-f44d-b641-805c705cc3b0"]
}], "Subtitle",
 CellChangeTimes->{{4.0031813917584476`*^9, 
  4.0031814352042503`*^9}},ExpressionUUID->"de49403a-d0c1-d740-b278-\
43f015048cb4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Q", "=", 
    RowBox[{"mu", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "xvec", ",", "xvec"}], "]"}], "-", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"xvec", ".", "xvec"}], ")"}], "/", "3"}], " ", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], ")"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Quadrupole", " ", "moment", " ", "tensor"}], "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"TraceCheck", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Tr", "[", "Q", "]"}], "]"}]}], 
  RowBox[{"(*", 
   RowBox[{"Trace", " ", "verification"}], "*)"}], ";"}]}], "Input",
 CellChangeTimes->{{4.0031814386876907`*^9, 4.0031814653394756`*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"9791decb-1b45-9047-b8a6-e42ba3899a51"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Keplerian orbital parametrization: Orbital Trajectory ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"r", "(", "\[Psi]", ")"}], "=", 
    FractionBox["R", 
     RowBox[{"1", "+", "\[Epsilon]cos\[Psi]"}]]}], TraditionalForm]],
  ExpressionUUID->"e87a8c08-851a-5349-8769-ce6f7c1383dc"]
}], "Subtitle",
 CellChangeTimes->{
  4.0031815004846478`*^9, {4.0031815322720413`*^9, 
   4.0031815344775143`*^9}},ExpressionUUID->"a3b79e56-13ea-1f4f-a217-\
188210bee7c3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rOrbit", "=", 
    RowBox[{"R", "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"e", " ", 
        RowBox[{"Cos", "[", "psi", "]"}]}]}], ")"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Orbital", " ", "parameters"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xOrbit", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"rOrbit", " ", 
       RowBox[{"Cos", "[", "psi", "]"}]}], ",", 
      RowBox[{"rOrbit", " ", 
       RowBox[{"Sin", "[", "psi", "]"}]}], ",", "0"}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Relative", " ", "position", " ", "along", " ", "the", " ", "orbit"}], 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Qpsi", "=", 
    RowBox[{"Q", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "[", "t", "]"}], "->", "rOrbit"}], ",", 
       RowBox[{
        RowBox[{"phi", "[", "t", "]"}], "->", "psi"}]}], "}"}]}]}], ";"}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{
   "Quadrupole", " ", "tensor", " ", "along", " ", "the", " ", "orbit"}], 
   "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hKepler", "=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"G", " ", "M", " ", "R"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Specific", " ", "angular", " ", "momentum", " ", 
    FormBox[
     RowBox[{"h", "=", 
      SuperscriptBox[
       RowBox[{"(", "GMR", ")"}], 
       RowBox[{"1", "/", "2"}]]}],
     TraditionalForm]}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "dTime", "]"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Time", " ", "derivative", " ", "operator"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dTime", "[", "expr_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"hKepler", "/", 
       RowBox[{"rOrbit", "^", "2"}]}], ")"}], " ", 
     RowBox[{"D", "[", 
      RowBox[{"expr", ",", "psi"}], "]"}]}]}], " ", 
   RowBox[{"(*", 
    RowBox[{
     FractionBox["d", "dt"], "=", " ", 
     RowBox[{
      FractionBox["h", 
       SuperscriptBox["r", "2"]], " ", 
      FractionBox["d", 
       RowBox[{"d", " ", "\[Psi]"}]]}]}], "*)"}], ";"}], "  "}]}], "Input",
 CellChangeTimes->{{4.0031815580183735`*^9, 4.003181653646265*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"7345440b-0880-1344-8daa-538c83d8ae17"]
}, Open  ]],

