   "Conservation", " ", "of", " ", "energy", " ", "at", " ", "periapsis", " ",
     "and", " ", "apoapsis"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
