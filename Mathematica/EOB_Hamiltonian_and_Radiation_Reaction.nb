    RowBox[{
    "Introduce", " ", "an", " ", "auxiliary", " ", "variable", " ", "L2C"}], "=", 
    RowBox[{"pPhiC", "^", "2"}]}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HperiC", "=", 
    RowBox[{
     RowBox[{"L2C", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"rpC", "^", "2"}]}], ")"}]}], "-", 
     RowBox[{"1", "/", "rpC"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HapoC", "=", 
    RowBox[{
     RowBox[{"L2C", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"raC", "^", "2"}]}], ")"}]}], "-", 
     RowBox[{"1", "/", "raC"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Solve", " ", "for", " ", "the", " ", "squared", " ", "angular", " ", 
    "momentum"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pPhiSquaredRuleC", "=", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"HperiC", "==", "HapoC"}], ",", "L2C"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pPhiSquaredC", "=", 
