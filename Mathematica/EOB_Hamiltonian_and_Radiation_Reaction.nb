   4.0031895722696476`*^9}},ExpressionUUID->"1719c108-9a8d-314a-b5a4-\
2dbd942291a7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dtDpsiD", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"rOrbitD", "^", "2"}], "/", "pPhiOrbitD"}], ",", 
      RowBox[{"Assumptions", "->", "assumptionsD"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Time", " ", "differential", " ", "with", " ", "respect", " ", "to", " ", 
    "the", " ", "orbital", " ", "angle"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"orbitalPeriodD", "=", 
    RowBox[{"2", " ", "Pi", " ", 
     RowBox[{"aSemiC", "^", 
      RowBox[{"(", 
       RowBox[{"3", "/", "2"}], ")"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Keplerian", " ", "orbital", " ", "period"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Orbital", " ", "average", " ", "operator"}], "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"OrbitalAverageD", "[", "expr_", "]"}], ":=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "orbitalPeriodD"}], ")"}], "*", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"expr", "*", "dtDpsiD"}], ",", 
         RowBox[{"{", 
          RowBox[{"psiC", ",", "0", ",", 
           RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
         RowBox[{"Assumptions", "->", "assumptionsD"}]}], "]"}]}], ",", 
      RowBox[{"Assumptions", "->", "assumptionsD"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Direct", " ", "verification", " ", "of", " ", 
    RowBox[{"Kepler", "'"}], "s", " ", "third", " ", "law"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PeriodIntegralD", "=", 
    RowBox[{"Integrate", "[", 
     RowBox[{"dtDpsiD", ",", 
      RowBox[{"{", 
       RowBox[{"psiC", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"0", "<", "eccC", "<", "1"}], "&&", 
        RowBox[{"aSemiC", ">", "0"}]}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PeriodCheckD", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"PeriodIntegralD", "-", "orbitalPeriodD"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"0", "<", "eccC", "<", "1"}], "&&", 
        RowBox[{"aSemiC", ">", "0"}]}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", "PeriodCheckD"}], "Input",
 CellChangeTimes->{{4.003189451471361*^9, 4.003189466359579*^9}, {
  4.0031895294017124`*^9, 4.0031895390208416`*^9}},
